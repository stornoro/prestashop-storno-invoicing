# Deny direct access to PHP files in this module directory.
<IfModule mod_authz_core.c>
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.php$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>
